@define-color bg #1c1c1f;
@define-color bg-input #242427;
@define-color bg-hover #2a2a2e;
@define-color fg #e6e6e6;
@define-color fg-dim #8e8e93;
@define-color accent #7070a9;
@define-color accent-alpha rgba(112, 112, 169, 0.25);
@define-color border #2e2e33;
@define-color error-bg #a970a9;
@define-color error-fg #e6e6e6;

* {
  all: unset;
  font-family: "JetBrainsMono Nerd Font";
}

popover {
  background: @bg;
  border: 1px solid @border;
  border-radius: 16px;
  padding: 6px;
}

scrollbar {
  opacity: 0;
}

.normal-icons {
  -gtk-icon-size: 16px;
}

.large-icons {
  -gtk-icon-size: 28px;
}

.box-wrapper {
  background: @bg;
  border-radius: 16px;
  border: 1px solid @border;
  padding: 8px;
  min-width: 620px;
}

.box {
  padding: 4px 0;
}

.search-container {
  background: @bg-input;
  border-radius: 10px;
  margin: 4px 6px;
}

.input {
  caret-color: @accent;
  padding: 12px 14px;
  color: @fg;
  font-size: 15px;
}

.input selection {
  background: @accent-alpha;
  color: @fg;
}

.input placeholder {
  opacity: 0.35;
  color: @fg-dim;
}

.content-container {
  margin: 2px 0;
}

.placeholder {
  color: @fg-dim;
  font-size: 13px;
  padding: 20px 0;
  opacity: 0.5;
}

.list {
  color: @fg;
  padding: 2px 0;
}

.item-box {
  border-radius: 8px;
  padding: 10px 12px;
  margin: 0 4px;
}

child:selected .item-box,
row:selected .item-box {
  background: @accent-alpha;
}

.item-text-box {
  margin-left: 12px;
}

.item-text {
  font-size: 13px;
}

.item-subtext {
  font-size: 11px;
  opacity: 0.4;
}

.providerlist .item-subtext {
  opacity: 0.6;
}

.item-image-text {
  font-size: 20px;
  min-width: 28px;
  opacity: 0.7;
}

.preview {
  border: 1px solid @border;
  border-radius: 10px;
  padding: 10px;
  color: @fg;
}

.preview-box {
  color: @fg-dim;
}

.calc .item-text {
  font-size: 22px;
}

.symbols .item-image {
  font-size: 22px;
}

.keybinds {
  padding: 6px 10px 2px;
  border-top: 1px solid @border;
  font-size: 11px;
  color: @fg-dim;
}

.keybind-button {
  background: @bg-hover;
  border-radius: 6px;
  padding: 2px 8px;
  opacity: 0.6;
}

.keybind-button:hover {
  opacity: 0.9;
}

.keybind-bind {
  opacity: 0.3;
}

.keybind-label {
  padding: 2px 6px;
  border-radius: 4px;
  border: 1px solid @border;
  font-size: 10px;
}

.error {
  padding: 8px 12px;
  background: @error-bg;
  color: @error-fg;
  border-radius: 8px;
  margin: 4px 6px 0;
}

:not(.calc).current {
  font-style: italic;
}

.todo.done .item-text-box {
  opacity: 0.2;
}

.todo.urgent {
  font-size: 22px;
}

.todo.active {
  font-weight: bold;
}

.bluetooth.disconnected {
  opacity: 0.4;
}

.preview .large-icons {
  -gtk-icon-size: 56px;
}
